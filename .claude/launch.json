{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "eats",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "eats-prod",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "node scripts/build-static.mjs && npx next build && npx next start -p 3107"
      ],
      "port": 3107
    },
    {
      "name": "eats-curated",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "NEXT_PUBLIC_CURATED_RECOMMENDATIONS=1 NEXT_DIST_DIR=.next-curated npx next dev -p 3001"
      ],
      "port": 3001
    },
    {
      "name": "eats-rk",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "NEXT_DIST_DIR=.next-rk npx next dev -p ${PORT:-3002}"
      ],
      "port": 3002
    }
  ]
}