# Canonical public origin (production)
NEXT_PUBLIC_SITE_URL=https://eats.mapmyhyd.com
# Curated map, dish pages and recommendation voting. Keep off until preview review.
NEXT_PUBLIC_CURATED_RECOMMENDATIONS=0
# Optional dedicated server-only cookie signing secret. Falls back to Firebase private key.
RECOMMENDATION_COOKIE_SECRET=

# Google Maps — server-side key (seed + cron, never sent to browser)
GOOGLE_MAPS_API_KEY=
# Google Maps — public key (place photos in sidebar; restrict by domain in Google Console)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Firebase client (safe to expose — prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server-only — paste stringified service-account JSON)
FIREBASE_SERVICE_ACCOUNT=

# Firecrawl (offer scraping)
FIRECRAWL_API_KEY=

# Admin panel secret (protects /admin and /api/admin/* routes)
ADMIN_SECRET=

# Cron auth (set same value in Vercel env + call header)
CRON_SECRET=
